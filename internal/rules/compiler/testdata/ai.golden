route /v1/chat/*
0000 REQUIRE_AUTH
0001 LOAD_FIELD 0
0002 BUDGET #0 5000000/day
0003 JUMP_IF_FIELD_NE field6 "large" -> 10
0004 LOAD_FIELD 7
0005 PUSH_CONST 1000
0006 GT
0007 JUMP_IF_FALSE 10
0008 LOAD_FIELD 0
0009 BUDGET #1 1500000/hour
0010 LOAD_FIELD 8
0011 CALL_BUILTIN 3
0012 PUSH_CONST 4000
0013 GT
0014 JUMP_IF_FALSE 16
0015 DENY 413
0016 RETURN

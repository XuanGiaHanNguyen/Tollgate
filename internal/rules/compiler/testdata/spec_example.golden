route /api/ai/*
0000 REQUIRE_AUTH
0001 JUMP_IF_FIELD_NE field1 "free" -> 4
0002 LOAD_FIELD 0
0003 LIMIT #0 10/minute
0004 JUMP_IF_FIELD_NE field1 "pro" -> 7
0005 LOAD_FIELD 0
0006 LIMIT #1 200/minute
0007 JUMP_IF_HEADER_EQ "X-Debug" "" -> 9
0008 DENY 403
0009 JUMP_IF_FIELD_NE field1 "free" -> 11
0010 JUMP_IF_CIDR field2 10.0.0.0/8 -> 16
0011 PUSH_CONST "x"
0012 CALL_BUILTIN 1
0013 PUSH_CONST "1"
0014 EQ
0015 JUMP_IF_FALSE 18
0016 LOAD_FIELD 1
0017 SET_HEADER "X-Flag"
0018 RETURN

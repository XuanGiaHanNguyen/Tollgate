(let free_tier (== user.tier "free"))
(route "/api/ai/*"
  (require auth)
  (when free_tier
    (limit#0 10 per minute by user.id)
  )
  (when (== user.tier "pro")
    (limit#1 200 per minute by user.id)
  )
  (when (!= (call header "X-Debug") "")
    (deny 403)
  )
)
(route "/api/public/*"
  (limit#2 30 per minute by client.ip)
)

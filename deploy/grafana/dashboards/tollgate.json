      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(process_cpu_seconds_total{job=\"tollgate-gw\"}[1m])",
          "legendFormat": "cpu {{instance}}",
          "refId": "A"

        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_resident_memory_bytes{job=\"tollgate-gw\"}/1e6",
          "legendFormat": "rss MB {{instance}}",
          "refId": "B"
        }

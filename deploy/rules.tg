# Policy for the docker-compose gateway (rule language, M3).
# Reloaded automatically when this file changes.

let free_tier = user.tier == "free"

route "/api/ai/*" {
  require auth
  when free_tier          { limit 10 per minute by user.id }
  when user.tier == "pro" { limit 200 per minute by user.id }
  when header("X-Debug") != "" { deny 403 }
  set_header "X-User-Id" user.id
}

route "/api/public/*" {
  limit 30 per minute by client.ip
}

# AI route (M5): cost budget, hedging across two providers, streaming safety filter.
route "/v1/chat/*" {
  require auth
  providers ["provider-a", "provider-b"]
  hedge after p95 max 5%
  block_patterns "kid-safety" action redact
  budget 5.00 usd per day by user.id
  when user.tier == "free" { budget 1.00 usd per hour by user.id }
  set_header "X-User-Id" user.id
}

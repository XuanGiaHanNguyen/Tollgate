listen: ":8080"
admin_listen: ":9090"
upstreams:
  - name: api
    targets:
%{ for b in backs ~}
      - url: http://${b}.${domain}:9000
%{ endfor ~}
    health_check: {path: /healthz, interval: 1s, timeout: 500ms, unhealthy_threshold: 1, healthy_threshold: 2}
  - name: provider-a
    targets: [{url: "http://provider-a.${domain}:9200"}]
  - name: provider-b
    targets: [{url: "http://provider-b.${domain}:9200"}]
routes:
  - {name: ai, type: ai, prefix: /v1/, upstream: provider-a, timeouts: {header: 30s, total: 120s}}
  - {name: api, prefix: /, upstream: api, retry: {attempts: 2}}
control:
  endpoints: [%{ for i, c in ctl }%{ if i > 0 }, %{ endif }"${c}.${domain}:7200"%{ endfor }]
  cache_file: /tmp/tollgate-rules-cache.json
cluster:
  listen: ":7000"
  self: ${gws[0]}
  members:
%{ for g in gws ~}
    - {name: ${g}, addr: "${g}.${domain}:7000"}
%{ endfor ~}
ai:
  pricing:
    "*": {input_per_1k_usd: 1.0, output_per_1k_usd: 3.0}
  pattern_sets:
    kid-safety: ["secret code", "home address", "phone number"]
